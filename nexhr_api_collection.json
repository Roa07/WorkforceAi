              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Mark my attendance for today\",\n  \"history\": []\n}"
            },
            "url": {"raw": "{{base_url}}/api/chat", "host": ["{{base_url}}"], "path": ["api", "chat"]}
          }
        },
        {
          "name": "Chatbot: Check Leave Balance",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
