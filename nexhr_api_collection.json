          }
        },
        {
          "name": "Chatbot: Run Payroll Preview",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Run payroll for October 2026\",\n  \"history\": []\n}"
            },
            "url": {"raw": "{{base_url}}/api/chat", "host": ["{{base_url}}"], "path": ["api", "chat"]}
          }
        }
      ]
    }
  ]
}
